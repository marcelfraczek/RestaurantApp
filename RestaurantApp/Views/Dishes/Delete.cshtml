@model RestaurantApp.Models.Dish

@{
    ViewData["Title"] = "Usuń danie";
}

<h2>Usuń danie</h2>

<h3>Czy na pewno chcesz usunąć to danie?</h3>

<div class="card" style="padding: 20px; max-width: 500px;">
    <p><strong>Nazwa:</strong> @Model.Name</p>
    <p><strong>Opis:</strong> @Model.Description</p>
    <p><strong>Kategoria:</strong> @Model.Category</p>
    <p><strong>Cena:</strong> @Model.Price</p>

    @if (!string.IsNullOrEmpty(Model.ImagePath))
    {
        <p><strong>Zdjęcie:</strong></p>
        <img src="@Model.ImagePath" alt="Zdjęcie dania" style="max-width: 300px; border: 1px solid #ccc; padding: 5px;" />
    }
</div>

<form asp-action="DeleteConfirmed" method="post" style="margin-top: 20px;">
    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">Usuń</button>
    <a asp-action="Index" class="btn btn-secondary">Powrót</a>
</form>
